# =============================================================================
# Object build statements for STATIC_LIBRARY target vk-bootstrap


#############################################
# Order-only phony target for vk-bootstrap

build cmake_object_order_depends_target_vk-bootstrap: phony || .

build third-party/vk-bootstrap/CMakeFiles/vk-bootstrap.dir/src/VkBootstrap.cpp.o: CXX_COMPILER__vk-bootstrap_unscanned_ /home/matty/projects/bulkin/third-party/vk-bootstrap/src/VkBootstrap.cpp || cmake_object_order_depends_target_vk-bootstrap
  DEP_FILE = third-party/vk-bootstrap/CMakeFiles/vk-bootstrap.dir/src/VkBootstrap.cpp.o.d
  FLAGS = -std=gnu++23 -Wall -Wextra -Wconversion -Wsign-conversion
  INCLUDES = -I/home/matty/projects/bulkin/third-party/vk-bootstrap/src -isystem /home/matty/vulkansdk/1.4.328.1/x86_64/include
  OBJECT_DIR = third-party/vk-bootstrap/CMakeFiles/vk-bootstrap.dir
  OBJECT_FILE_DIR = third-party/vk-bootstrap/CMakeFiles/vk-bootstrap.dir/src
  TARGET_COMPILE_PDB = third-party/vk-bootstrap/CMakeFiles/vk-bootstrap.dir/
  TARGET_PDB = third-party/vk-bootstrap/libvk-bootstrap.pdb
  TARGET_SUPPORT_DIR = third-party/vk-bootstrap/CMakeFiles/vk-bootstrap.dir


# =============================================================================
# Link build statements for STATIC_LIBRARY target vk-bootstrap


#############################################
# Link the static library third-party/vk-bootstrap/libvk-bootstrap.a

build third-party/vk-bootstrap/libvk-bootstrap.a: CXX_STATIC_LIBRARY_LINKER__vk-bootstrap_ third-party/vk-bootstrap/CMakeFiles/vk-bootstrap.dir/src/VkBootstrap.cpp.o
  OBJECT_DIR = third-party/vk-bootstrap/CMakeFiles/vk-bootstrap.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = third-party/vk-bootstrap/CMakeFiles/vk-bootstrap.dir/
  TARGET_FILE = third-party/vk-bootstrap/libvk-bootstrap.a
  TARGET_PDB = third-party/vk-bootstrap/libvk-bootstrap.pdb
  TARGET_SUPPORT_DIR = third-party/vk-bootstrap/CMakeFiles/vk-bootstrap.dir


#############################################
# Utility command for edit_cache

build third-party/vk-bootstrap/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/matty/projects/bulkin/build/third-party/vk-bootstrap && /usr/bin/ccmake -S/home/matty/projects/bulkin -B/home/matty/projects/bulkin/build
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build third-party/vk-bootstrap/edit_cache: phony third-party/vk-bootstrap/CMakeFiles/edit_cache.util


